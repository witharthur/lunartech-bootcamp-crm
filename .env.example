# LunarTech CRM - example environment variables
# Copy this file to .env and fill with your real secrets before running

# Server
NODE_ENV=development
PORT=5173

# Database (Neon/Postgres)
# Example format: postgresql://user:password@host:port/dbname?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:password@ep-your-neon-host/neondb?sslmode=require&channel_binding=require

# OpenAI (used for embeddings and chat RAG)
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# Stripe (test keys shown as placeholders)
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Cal.com (API key used to derive embed link; or provide CAL_EMBED_LINK directly)
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alternatively, set an explicit embed link (e.g. cal.com/yourhandle/30min)
CAL_EMBED_LINK=

# JWT / Auth
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_PASSWORD=change_this_production_password

# Optional: Sentry for error monitoring
SENTRY_DSN=

# Optional: Email (SMTP) for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LunarTech <noreply@yourdomain.com>"

# Notes:
# - Keep secrets out of version control. Use your hosting provider's secret store in production.
# - Use secure cookie settings (secure=true) in production and ensure JWT_SECRET is strong.
# - If you connect a real database, update DATABASE_URL and ensure network access from the app host.
